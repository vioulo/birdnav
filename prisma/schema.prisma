generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  auditLogs    AuditLog[]
  sessions     AdminSession[]

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(160)
  color     String   @default("#4c6fff") @db.VarChar(20)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  sites     Site[]

  @@map("cats")
}

model Site {
  id          Int       @id @default(autoincrement())
  catId       Int       @map("cat_id")
  name        String    @db.VarChar(160)
  url         String    @db.VarChar(500)
  iconUrl     String?   @map("icon_url") @db.VarChar(500)
  description String?   @db.VarChar(500)
  isFeatured  Boolean   @default(false) @map("is_featured")
  featureImage String?  @map("feature_image") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category  @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@map("sites")
}

model Option {
  id        Int      @id @default(autoincrement())
  optKey    String   @unique @map("opt_key") @db.VarChar(120)
  optValue  String   @map("opt_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("options")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.VarChar(120)
  summary     String   @db.VarChar(255)
  payload     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([targetType, createdAt])
  @@map("audit_logs")
}

model AdminSession {
  id        String    @id @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuthThrottle {
  scopeKey      String    @id @map("scope_key") @db.VarChar(191)
  attempts      Int       @default(0)
  blockedUntil  DateTime? @map("blocked_until")
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  lastAttemptAt DateTime  @default(now()) @map("last_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("auth_throttles")
}
